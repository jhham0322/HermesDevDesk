<Application x:Class="Hermes.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#151D2C"/><SolidColorBrush x:Key="Ink" Color="#E6EDF7"/><SolidColorBrush x:Key="Muted" Color="#A6B5CA"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101929"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#34425A"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="#69D3B2"/><Setter Property="SelectionBrush" Value="#365F7B"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#263751"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="160"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#34425A"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="#142036"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
 </Application.Resources>
</Application>
