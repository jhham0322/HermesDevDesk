<Window x:Class="Hermes.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Hermes DevDesk 0.8.6" Icon="Assets/Hermes.ico" FontFamily="Segoe UI, Malgun Gothic" FontSize="18" Foreground="{DynamicResource Ink}" Width="1280" Height="920" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="Window_KeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Canvas}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel x:Name="TitleBar" Background="{DynamicResource Rail}" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Width="45" Click="Minimize_Click" AutomationProperties.Name="최소화"/><Button Content="□" Width="45" Click="Maximize_Click" AutomationProperties.Name="최대화"/><Button Content="×" Width="45" Click="Close_Click" AutomationProperties.Name="닫기"/></StackPanel>
    <Button x:Name="ComputerGlobalStop" DockPanel.Dock="Right" Content="컴퓨터 제어 중단 · Ctrl+Alt+F12" Click="ComputerStop_Click" Visibility="Collapsed" Background="#FCE5E5" Foreground="#A22525"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="Back_Click" ToolTip="이전 대화"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.arrow_left}"/></Button><Button Style="{StaticResource IconButton}" Click="Forward_Click" ToolTip="다음 대화"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.arrow_right}"/></Button><Button Style="{StaticResource IconButton}" Click="Sidebar_Click" ToolTip="사이드바 · Ctrl+B"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.panel_left}"/></Button>
    <Menu Background="Transparent" VerticalAlignment="Center"><MenuItem Header="파일"><MenuItem Header="새 채팅   Ctrl+N" Click="NewTask_Click"/><MenuItem Header="프로젝트 추가" Click="Register_Click"/><Separator/><MenuItem Header="로컬 Git 및 원격 서버" Click="GitSettings_Click"/><MenuItem Header="CLI 선택" Click="ChooseCli_Click"/><MenuItem Header="엔진 연결" Click="Connect_Click"/><Separator/><MenuItem Header="종료" Click="Close_Click"/></MenuItem><MenuItem Header="편집"><MenuItem Header="채팅 이름 변경" Click="Rename_Click"/><MenuItem Header="대화 복사" Click="CopyChat_Click"/><MenuItem Header="대화 내보내기" Click="ExportChat_Click"/><Separator/><MenuItem Header="채팅 삭제" Click="DeleteChat_Click"/></MenuItem><MenuItem Header="보기"><MenuItem Header="명령 팔레트   Ctrl+K" Click="Palette_Click"/><MenuItem Header="밝게 / 어둡게" Click="Theme_Click"/><MenuItem Header="오른쪽 패널   Ctrl+J" Click="Inspector_Click"/><MenuItem Header="입력 Enter 전송" x:Name="EnterSendMenu" IsCheckable="True" IsChecked="True" Click="EnterSend_Click"/></MenuItem><MenuItem Header="도움말"><MenuItem Header="오류 로그 폴더 열기" Click="OpenLogs_Click"/><MenuItem Header="기능 및 연결 상태" Click="Capabilities_Click"/><MenuItem Header="단축키" Click="Shortcuts_Click"/></MenuItem></Menu>
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition x:Name="SidebarColumn" Width="358"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorSplitColumn" Width="0"/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Rail}"><DockPanel LastChildFill="False" Margin="5,16,5,10"><Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="설정"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.settings}"/></Button><StackPanel DockPanel.Dock="Top"><Button Style="{StaticResource IconButton}" Background="{DynamicResource Selected}" Click="Home_Click" ToolTip="홈"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.home}"/></Button><Button Style="{StaticResource IconButton}" Click="NewTask_Click" ToolTip="새 채팅"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.chat}"/></Button><Button Style="{StaticResource IconButton}" Click="Schedule_Click" ToolTip="예약 초안"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.clock}"/></Button><Button Style="{StaticResource IconButton}" Click="Palette_Click" ToolTip="명령 팔레트"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.more_horizontal}"/></Button><Border Height="1" Background="{DynamicResource Line}" Margin="8,16"/><Button Style="{StaticResource IconButton}" Click="Mcp_Click" ToolTip="MCP 연결"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.plug_connected}"/></Button><Button Style="{StaticResource IconButton}" Click="ComputerPanel_Click" ToolTip="Windows 컴퓨터 제어"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.desktop}"/></Button><Button Style="{StaticResource IconButton}" Click="BrowserPanel_Click" ToolTip="브라우저"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.globe}"/></Button><Button Style="{StaticResource IconButton}" Click="Skills_Click" ToolTip="스킬"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.code}"/></Button></StackPanel></DockPanel></Border>
    <Border x:Name="SidebarPane" Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
     <Grid Margin="12,16,12,8"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="SearchFocus_Click" ToolTip="검색 · Ctrl+F"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.search}"/></Button><Image Source="Assets/Hermes.png" Width="30" Height="30" VerticalAlignment="Center"/><TextBlock Text="Hermes" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/></DockPanel>
      <Button Grid.Row="1" Click="NewTask_Click" HorizontalContentAlignment="Left" Margin="0,8"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.chat}" Margin="0,0,12,0"/><TextBlock Text="새 채팅" FontSize="18"/></StackPanel></Button>
      <StackPanel Grid.Row="2" x:Name="SearchPanel" Visibility="Collapsed"><TextBox x:Name="Search" AutomationProperties.Name="작업·대화 검색" TextChanged="Search_Changed"/><WrapPanel><CheckBox x:Name="SearchAll" Content="모든 프로젝트" Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/><CheckBox x:Name="ArchivedOnly" Content="보관함" Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/></WrapPanel></StackPanel>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SidebarGroups"/></ScrollViewer>
      <DockPanel Grid.Row="4"><Button Content="프로젝트 추가" Click="Register_Click"/><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ArchiveView_Click" ToolTip="보관함"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.folder}"/></Button></DockPanel>
      <ListBox x:Name="Projects" Visibility="Collapsed" SelectionChanged="Project_Selected"/><ListBox x:Name="Tasks" Visibility="Collapsed" SelectionChanged="Task_Selected"/>
     </Grid>
    </Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/></Grid.RowDefinitions>
     <StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ChatTabs" Orientation="Horizontal" Margin="12,4"/></ScrollViewer><DockPanel Margin="20,8,16,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Git 커밋" Click="Commit_Click" ToolTip="선택한 프로젝트의 변경을 로컬 Git에 커밋"/><Button Style="{StaticResource IconButton}" Click="ChatMenu_Click" ToolTip="채팅 메뉴"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.more_horizontal}"/></Button><Button Style="{StaticResource IconButton}" Click="ReviewPanel_Click" ToolTip="변경 검토"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.branch}"/></Button><Button Style="{StaticResource IconButton}" Click="Inspector_Click" ToolTip="패널"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.panel_right}"/></Button></StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.folder}" Margin="4,0,12,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TaskTitle" Text="새 채팅" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="430"/><TextBlock x:Name="RootLabel" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="430"/></StackPanel></StackPanel></DockPanel></StackPanel>
     <Grid Grid.Row="1"><ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MessageStack" Margin="30,18,30,20" MaxWidth="860" HorizontalAlignment="Stretch"/></ScrollViewer><StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock Text="무엇을 만들어 볼까요?" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="프로젝트를 선택하고 Hermes와 함께 작업하세요" Foreground="{DynamicResource Muted}" Margin="0,12,0,22" HorizontalAlignment="Center"/><WrapPanel HorizontalAlignment="Center"><Button Content="프로젝트 열기" Click="Register_Click"/><Button Content="연결 설정" Click="Settings_Click"/></WrapPanel></StackPanel><TextBox x:Name="Transcript" Visibility="Collapsed"/></Grid>
     <StackPanel Grid.Row="2" Margin="22,0,22,4" MaxWidth="920">
      <Button x:Name="ChangeSummary" Content="변경 검토" Click="ReviewPanel_Click" HorizontalAlignment="Center" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
      <DockPanel Margin="10,4"><TextBlock x:Name="TaskStatus" Foreground="{DynamicResource Muted}" FontSize="12"/><Button x:Name="ApprovalBadge" Content="승인 요청 검토" Click="ApprovalPanel_Click" DockPanel.Dock="Right" Visibility="Collapsed"/></DockPanel>
      <Border CornerRadius="24" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Canvas}" Padding="12">
       <StackPanel><Grid><TextBox x:Name="Prompt" MinHeight="65" MaxHeight="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6,8" AutomationProperties.Name="작업 지시" TextChanged="Draft_Changed"/><TextBlock x:Name="PromptPlaceholder" Text="Hermes와 함께 작업하세요" Foreground="{DynamicResource Muted}" Margin="7,10" IsHitTestVisible="False"/></Grid>
        <ListBox x:Name="Attachments" MaxHeight="65"/>
        <WrapPanel><Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="AddMenu_Click" ToolTip="첨부 및 도구"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.add}"/></Button><CheckBox DockPanel.Dock="Left" x:Name="Writable" Click="Writable_Click" IsChecked="True" Content="전체 권한" ToolTip="기본 허용: 프로젝트 밖 파일 접근·명령 실행·네트워크. 해제하면 읽기 전용." VerticalAlignment="Center" FontSize="14"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="Model" Width="180" AutomationProperties.Name="공식 모델" SelectionChanged="Model_Changed"/><ComboBox x:Name="Effort" Width="100" AutomationProperties.Name="추론 수준"/><Button x:Name="StopButton" Style="{StaticResource IconButton}" Click="Stop_Click" ToolTip="중단" Visibility="Collapsed"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.stop}"/></Button><Button x:Name="StartButton" Style="{StaticResource IconButton}" Click="Start_Click" ToolTip="전송 · Enter" Background="{DynamicResource Selected}"><Path Style="{StaticResource Icon}" Data="{StaticResource Icon.arrow_up}"/></Button></StackPanel></WrapPanel>
        <WrapPanel><TextBlock x:Name="SkillHint" Text="" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="AttachmentHint" Text="" FontSize="11" Foreground="{DynamicResource Muted}"/></WrapPanel>
       </StackPanel>
      </Border>
      <TextBlock x:Name="ProviderHint" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="12,4,0,0"/>
     </StackPanel>
     <DockPanel Grid.Row="3" Margin="22,0"><TextBlock x:Name="Connection" Foreground="{DynamicResource Muted}" FontSize="10" MaxWidth="270" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Footer" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
    <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>
    <Border x:Name="InspectorPane" Grid.Column="4" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Line}" Visibility="Collapsed"><TabControl x:Name="InspectorTabs">
    <TabItem Header="파일"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="상위" Click="FilesUp_Click"/><Button Content="새로고침" Click="FilesRefresh_Click"/><TextBlock x:Name="FileDirectory" Text="/" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel><ListBox Grid.Row="1" x:Name="Files" MouseDoubleClick="File_Open"/><TextBox Grid.Row="2" x:Name="FilePreview" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="Git 변경"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Git 새로고침" Click="GitDiff_Click"/><Button Content="작업 변경" Click="TurnDiff_Click"/><Button Content="선택 파일 열기" Click="ChangeOpen_Click"/><Button Content="스테이징" Click="Stage_Click"/><Button Content="스테이징 취소" Click="Unstage_Click"/><Button Content="커밋" Click="Commit_Click"/></WrapPanel><ListBox Grid.Row="1" x:Name="ChangedFiles" SelectionChanged="Change_Selected"/><TextBlock Grid.Row="2" x:Name="ReviewStatus" Text="변경 목록을 조회하세요" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="4,8"/><TextBox Grid.Row="3" x:Name="Diff" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="작업"><TextBox x:Name="TaskDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
    <TabItem Header="승인"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="요청별 일회성 결정. 프로젝트 밖 권한은 차단합니다." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><ListBox Grid.Row="1" x:Name="ApprovalList" SelectionChanged="Approval_Selected"/><TextBox Grid.Row="2" x:Name="ApprovalDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="3"><CheckBox x:Name="EscalationConsent" Content="이 명령의 샌드박스 밖 실행 가능성을 확인함"/><Button Content="요청 승인 / 질문 답변" Click="Accept_Click"/><Button Content="거절" Click="Decline_Click"/></StackPanel></Grid></TabItem>
    <TabItem Header="로그"><TextBox x:Name="Logs" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem>
    <TabItem Header="사용량"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="UTC 기간 · 종료 날짜까지 포함"/><WrapPanel><DatePicker x:Name="UsageStart" Width="160"/><DatePicker x:Name="UsageEnd" Width="160"/></WrapPanel><TextBox x:Name="UsageModel" AutomationProperties.Name="사용량 모델 필터"/><CheckBox x:Name="UsageTaskOnly" Content="선택 작업만"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="조회" Click="Usage_Click"/><Button Content="JSON 내보내기" Click="UsageExport_Click"/></WrapPanel><TextBox x:Name="UsageView" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="명령"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="실제 PowerShell 명령 · API 호출 아님 · 30초 제한 · 완료 후 표시 · 공식 sandbox 안에서 실행" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><TextBox x:Name="CommandText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Grid.Row="2"><CheckBox x:Name="CommandWritable" Content="프로젝트 쓰기"/><Button Content="명령 검토 후 실행" Click="CommandRun_Click"/><Button Content="명령 중단" Click="CommandStop_Click"/></WrapPanel><TextBox x:Name="CommandOutput" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid></TabItem>
    <TabItem Header="범위"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ink}" LineHeight="24" Text="Hermes DevDesk 0.8.6&#10;&#10;회사 API 기본: 사내 중계서버 자동 연결, Responses, Chat Completions, Anthropic Messages 호환 어댑터. 지정한 endpoint/deployment만 사용하며 공개 OpenAI 모델 API로 fallback하지 않습니다.&#10;&#10;사용자가 앱에 직접 입력한 키만 Windows DPAPI로 보관합니다. 실제 회사 인증·모델 지원은 회사 주소/배포명/키를 입력한 뒤 확인해야 합니다. Entra·인증서 설치·TLS 우회는 지원하지 않습니다.&#10;&#10;구현: 프로젝트 스킬 목록/선택/호출, 대화 보관/복원, 로컬 초안 예약/알림, 프로젝트 로컬 MCP 연결/목록/오류/승인, PNG/JPEG 이미지 입력, 대화 분기, 공식 AI 변경 검토, 프로젝트/작업/대화 이력, 공식 CLI 작업 시작·중단·재개, 파일·Git diff·승인, 격리 worktree, 검색, 사용량 관측, sandbox 안의 일회성 PowerShell 명령. 회사 API 응답과 Windows 터미널 결과는 완료 후 표시합니다.&#10;&#10;미지원: 컴퓨터 사용·브라우저 제어·음성·이미지 생성·외부 MCP 설치/로그인·클라우드·원격·모바일·자동화·공식 앱 프로젝트 동기화.&#10;&#10;기존 ChatGPT CLI 연결은 사용자가 별도로 선택할 때만 사용합니다. 앱이 인증파일·비공개 DB·기존 세션을 읽지 않습니다.&#10;&#10;엔진 sandbox의 읽기 권한은 OS 전체 격리를 보장하지 않습니다. 외부 실행 승인에는 별도 동의가 필요합니다. 전체 Codex Desktop 동등성을 주장하지 않는 독립 앱입니다."/></ScrollViewer></TabItem>
   </TabControl></Border>
   </Grid>
  </Grid>
 </Border>
</Window>