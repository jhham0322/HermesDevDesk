<Window x:Class="Hermes.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hermes DevDesk 0.5.1" Width="1440" Height="920" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E6EDF7" FontFamily="Segoe UI, Malgun Gothic" FontSize="14">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="HERMES  /  DEVDESK" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="독립 Windows 개발 에이전트 작업실" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="Connection" Text="엔진 연결 안 됨" VerticalAlignment="Center" Margin="15,0" Foreground="#69D3B2" MaxWidth="360" TextTrimming="CharacterEllipsis"/><Button Content="MCP" Click="Mcp_Click"/><Button Content="API 설정" Click="Settings_Click"/><Button Content="엔진 연결" Click="Connect_Click"/><Button Content="CLI 선택" Click="ChooseCli_Click"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="프로젝트" FontSize="16" VerticalAlignment="Center"/><Button Content="+ 등록" HorizontalAlignment="Right" Click="Register_Click"/></DockPanel>
     <ListBox x:Name="Projects" Grid.Row="1" SelectionChanged="Project_Selected"/>
     <StackPanel Grid.Row="2" Margin="0,12,0,4"><DockPanel><TextBlock Text="작업" FontSize="16" VerticalAlignment="Center"/><Button Content="+ 새 작업" HorizontalAlignment="Right" Click="NewTask_Click"/></DockPanel><WrapPanel><Button Content="대화 분기" Click="Fork_Click"/><Button Content="AI 변경 검토" Click="AiReview_Click"/></WrapPanel><Button Content="작업 초안 예약/알림" Click="Schedule_Click"/><Button Content="Git worktree 격리 작업" Click="IsolatedTask_Click"/><TextBlock Text="HEAD 커밋 기준 · 원본 파일 보존" FontSize="11" Foreground="{StaticResource Muted}" Margin="4"/></StackPanel>
     <StackPanel Grid.Row="3"><TextBox x:Name="Search" AutomationProperties.Name="작업·대화 검색" TextChanged="Search_Changed"/><CheckBox x:Name="ArchivedOnly" Content="보관함" Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/><WrapPanel><Button Content="대화 보관" Click="Archive_Click"/><Button Content="복원" Click="Restore_Click"/></WrapPanel><CheckBox x:Name="SearchAll" Content="모든 프로젝트에서 검색" Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/></StackPanel>
     <ListBox x:Name="Tasks" Grid.Row="4" SelectionChanged="Task_Selected"/>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#34425A"/>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12"><TextBlock x:Name="TaskTitle" Text="프로젝트를 등록하고 작업을 시작하세요" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="RootLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="TaskStatus" Foreground="#69D3B2" Margin="0,8,0,0"/></StackPanel>
     <TextBox x:Name="Transcript" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14"/>
     <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <WrapPanel><Button Content="프로젝트 스킬 선택" Click="Skills_Click"/><Button Content="스킬 비우기" Click="SkillClear_Click"/><TextBlock x:Name="SkillHint" Text="선택 스킬 없음" TextWrapping="Wrap" FontSize="11" Width="300"/></WrapPanel><WrapPanel><Button Content="프로젝트 이미지 첨부" Click="ImageAdd_Click"/><Button Content="첨부 비우기" Click="ImageClear_Click"/><TextBlock x:Name="AttachmentHint" Text="PNG/JPEG · 최대 4개/합계 3MB · 선택 이미지가 모델로 전송됨" TextWrapping="Wrap" FontSize="11" Width="340"/></WrapPanel><ListBox x:Name="Attachments" MaxHeight="70"/><TextBox x:Name="Prompt" MinHeight="95" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="작업 지시"/>
      <WrapPanel Margin="0,8,0,0"><ComboBox x:Name="Model" AutomationProperties.Name="공식 모델"/><CheckBox x:Name="Writable" Content="이번 작업에 프로젝트 쓰기 허용" VerticalAlignment="Center"/><Button x:Name="StartButton" Content="작업 실행 →" Background="#207C68" Click="Start_Click"/><Button Content="중단" Click="Stop_Click"/></WrapPanel>
      <TextBlock x:Name="ProviderHint" Text="회사 API 설정 필요 · 외부 fallback 없음 · 기본 읽기 전용" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,6,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="#34425A"/>
   <TabControl x:Name="InspectorTabs" Grid.Column="4">
    <TabItem Header="파일"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="상위" Click="FilesUp_Click"/><Button Content="새로고침" Click="FilesRefresh_Click"/><TextBlock x:Name="FileDirectory" Text="/" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel><ListBox Grid.Row="1" x:Name="Files" MouseDoubleClick="File_Open"/><TextBox Grid.Row="2" x:Name="FilePreview" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="diff"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Git 새로고침" Click="GitDiff_Click"/><Button Content="작업 변경" Click="TurnDiff_Click"/><Button Content="선택 파일 열기" Click="ChangeOpen_Click"/></WrapPanel><ListBox Grid.Row="1" x:Name="ChangedFiles" SelectionChanged="Change_Selected"/><TextBlock Grid.Row="2" x:Name="ReviewStatus" Text="변경 목록을 조회하세요" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,8"/><TextBox Grid.Row="3" x:Name="Diff" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="작업"><TextBox x:Name="TaskDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
    <TabItem Header="승인"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="요청별 일회성 결정. 프로젝트 밖 권한은 차단합니다." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><ListBox Grid.Row="1" x:Name="ApprovalList" SelectionChanged="Approval_Selected"/><TextBox Grid.Row="2" x:Name="ApprovalDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="3"><CheckBox x:Name="EscalationConsent" Content="이 명령의 샌드박스 밖 실행 가능성을 확인함"/><Button Content="요청 승인 / 질문 답변" Click="Accept_Click"/><Button Content="거절" Click="Decline_Click"/></StackPanel></Grid></TabItem>
    <TabItem Header="로그"><TextBox x:Name="Logs" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem>
    <TabItem Header="사용량"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="UTC 기간 · 종료 날짜까지 포함"/><WrapPanel><DatePicker x:Name="UsageStart" Width="160"/><DatePicker x:Name="UsageEnd" Width="160"/></WrapPanel><TextBox x:Name="UsageModel" AutomationProperties.Name="사용량 모델 필터"/><CheckBox x:Name="UsageTaskOnly" Content="선택 작업만"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="조회" Click="Usage_Click"/><Button Content="JSON 내보내기" Click="UsageExport_Click"/></WrapPanel><TextBox x:Name="UsageView" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
    <TabItem Header="명령"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="실제 PowerShell 명령 · API 호출 아님 · 30초 제한 · 완료 후 표시 · 공식 sandbox 안에서 실행" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBox x:Name="CommandText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Grid.Row="2"><CheckBox x:Name="CommandWritable" Content="프로젝트 쓰기"/><Button Content="명령 검토 후 실행" Click="CommandRun_Click"/><Button Content="명령 중단" Click="CommandStop_Click"/></WrapPanel><TextBox x:Name="CommandOutput" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid></TabItem>
    <TabItem Header="범위"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink}" LineHeight="24" Text="Hermes DevDesk 0.5.1&#10;&#10;회사 API 기본: Azure v1/legacy Responses, 사내 Gateway, Chat Completions 호환 어댑터. 지정한 endpoint/deployment만 사용하며 공개 OpenAI 모델 API로 fallback하지 않습니다.&#10;&#10;사용자가 앱에 직접 입력한 키만 Windows DPAPI로 보관합니다. 실제 회사 인증·모델 지원은 회사 주소/배포명/키를 입력한 뒤 확인해야 합니다. Entra·인증서 설치·TLS 우회는 지원하지 않습니다.&#10;&#10;구현: 프로젝트 스킬 목록/선택/호출, 대화 보관/복원, 로컬 초안 예약/알림, 프로젝트 로컬 MCP 연결/목록/오류/승인, PNG/JPEG 이미지 입력, 대화 분기, 공식 AI 변경 검토, 프로젝트/작업/대화 이력, 공식 CLI 작업 시작·중단·재개, 파일·Git diff·승인, 격리 worktree, 검색, 사용량 관측, sandbox 안의 일회성 PowerShell 명령. 회사 API 응답과 Windows 터미널 결과는 완료 후 표시합니다.&#10;&#10;미지원: 컴퓨터 사용·브라우저 제어·음성·이미지 생성·외부 MCP 설치/로그인·클라우드·원격·모바일·자동화·공식 앱 프로젝트 동기화.&#10;&#10;기존 ChatGPT CLI 연결은 사용자가 별도로 선택할 때만 사용합니다. 앱이 인증파일·비공개 DB·기존 세션을 읽지 않습니다.&#10;&#10;엔진 sandbox의 읽기 권한은 OS 전체 격리를 보장하지 않습니다. 외부 실행 승인에는 별도 동의가 필요합니다. 전체 Codex Desktop 동등성을 주장하지 않는 독립 앱입니다."/></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <TextBlock x:Name="Footer" Grid.Row="2" Text="로컬 이력 · 공식 stdio · 회사 모드의 임시 localhost bridge만 수신" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,14,0,0"/>
 </Grid>
</Window>
